.PHONY: ci fmt vet lint test race

ci: fmt vet lint race

fmt:
	@out=$$(gofmt -l .); if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi

vet:
	go vet ./...
	go vet -tags holepunch_faultinject ./...
	cd standalone && go vet ./... && go vet -tags holepunch_faultinject ./...

lint:
	go run ./tools/lintcheck ./...
	cd standalone && go run github.com/djylb/holepunch/tools/lintcheck ./...

test:
	go test -count=1 ./...

race:
	go test -race -count=1 ./...
	go test -race -count=1 -tags holepunch_faultinject ./...
	cd standalone && go test -race -count=1 ./...
	cd standalone && go test -race -count=1 -tags holepunch_faultinject ./...
	cd standalone && GOWORK=off go build ./...
